#!/usr/bin/env bash
# rp — Rebel Profiler, ONE command. Everything else is just talking to Hermes.
#
#   rp                  status panel: case, hermes model, bridge
#   rp talk             chat REPL with Hermes — plain language, zero ceremony
#   rp talk "<goal>"    one bounded hermes loop for that goal
#   rp <anything…>      ANY other words are a PROMPT to Hermes, not a command:
#                         rp recon example.com        → hermes plans + runs it
#                         rp add *.lab.test to scope  → hermes authorizes it
#                         rp show me the report       → hermes generates it
#   rp bridge           start the browser bridge for the extension
#
# Case ids, scope entries, subcommand mazes — gone. The model holds the
# operator tools (case/scope/report/verify/surface/browser) plus the gated
# adapter registry, and answers in plain language.
set -u

# Resolve symlinks (e.g. ~/.local/bin/rp) so the repo dir is found from PATH.
_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$_SELF")/.." && pwd)"
RP="$REPO/.venv/bin/rebel-profiler"
PY="$REPO/.venv/bin/python"
TOKEN_FILE="${RP_BRIDGE_TOKEN_FILE:-/tmp/rp_bridge_token}"
BRIDGE_LOG="${RP_BRIDGE_LOG:-/tmp/rp_bridge.log}"
COLOR=1

c() { [ "$COLOR" = 1 ] && printf "\033[%sm" "$1"; }
dim()  { c 2; printf "%s" "$1"; c 0; }
bold() { c 1; printf "%s" "$1"; c 0; }
grn()  { c 32; printf "%s" "$1"; c 0; }
red()  { c 31; printf "%s" "$1"; c 0; }
blu()  { c 36; printf "%s" "$1"; c 0; }

line() { dim "────────────────────────────────────────────────────────────"; }

# ---------------------------------------------------------------- state ---
newest_case() {
  "$RP" case list -o jsonl 2>/dev/null | "$PY" -c '
import json, sys
last, active = "", ""
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        c = json.loads(line)
    except json.JSONDecodeError:
        continue
    if isinstance(c, list):          # defensive: list-per-line exports
        c = c[0] if c else {}
    cid = str(c.get("id", ""))
    if not cid:
        continue
    last = cid
    if str(c.get("status", "")).lower() == "active":
        active = cid
print(active or last)
'
}

bridge_up() {
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 \
    -H "Authorization: Bearer $(cat "$TOKEN_FILE" 2>/dev/null)" \
    http://127.0.0.1:8765/healthz 2>/dev/null) || code=000
  [ "$code" = "200" ]
}

hermes_cmd() {
  # The one true entry: --config-file pins the local GGUF (hermes.toml).
  # Multi-word goals stay one argument; value-taking flags consume their value.
  local flags=() words=() goal="" next_is_value=0 a
  for a in "$@"; do
    if [ "$next_is_value" = 1 ]; then flags+=("$a"); next_is_value=0; continue; fi
    case "$a" in
      --llm|--model|--case|--max-turns) flags+=("$a"); next_is_value=1 ;;
      -*) flags+=("$a") ;;
      *) words+=("$a") ;;
    esac
  done
  goal="${words[*]:-}"
  if [ -f "$REPO/hermes.toml" ]; then
    exec "$RP" --config-file "$REPO/hermes.toml" hermes "${flags[@]}" ${goal:+"$goal"}
  fi
  exec "$RP" hermes "${flags[@]}" ${goal:+"$goal"}
}

# ------------------------------------------------------------- commands ---

do_status() {
  line
  echo "$(bold '        REBEL PROFILER')  $(dim '· rp — one command, baqi sab prompting')"
  line
  local CASE; CASE=$(newest_case || true)
  if [ -n "$CASE" ]; then
    local status
    status=$("$RP" case list -o jsonl 2>/dev/null | "$PY" -c "
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try: c = json.loads(line)
    except json.JSONDecodeError: continue
    if isinstance(c, list): c = c[0] if c else {}
    if str(c.get('id','')) == '$CASE':
        print(c.get('status','?')); break
" 2>/dev/null)
    if [ "$status" = "active" ]; then
      echo "  $(grn '●') case     $(bold "$CASE")  $(grn 'ACTIVE')"
    else
      echo "  $(blu '●') case     $CASE  $(dim "$status — chat mein 'activate the case' bolo")"
    fi
  else
    echo "  $(dim '●') koi case nahi — pehli chat mein khud ban jayega"
  fi
  local model; model=$("$PY" - "$REPO" <<'EOF'
import sys, tomllib
try:
    with open(sys.argv[1] + "/hermes.toml", "rb") as f:
        m = tomllib.load(f).get("llm", {}).get("model", "?")
    print(m.split("/")[-1])
except Exception:
    print("not pinned (hermes.toml missing)")
EOF
)
  echo "  $(blu '◆') hermes   $model"
  if bridge_up; then
    echo "  $(grn '●') bridge   127.0.0.1:8765  $(grn 'LIVE')"
  else
    echo "  $(red '●') bridge   down  — $(bold 'rp bridge')"
  fi
  line
  echo "  $(bold 'bas itna yaad rakho:')"
  echo "    $(blu 'rp talk')          chat kholo — plain language mein sab ho jata hai"
  echo "    $(blu 'rp \"<goal>\"')    ek goal do — recon, scope, report, jo bolo"
  echo "    $(blu 'rp bridge')        extension ke liye bridge start karo"
  line
}

do_bridge() {
  if bridge_up; then
    echo "$(grn '✓') bridge already live: 127.0.0.1:8765"
  else
  local CASE; CASE=$(newest_case || true)
  if [ -z "$CASE" ]; then
    CASE=$("$RP" case create "rp workspace" "created by rp bridge" -o json \
           | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["data"]["id"])' 2>/dev/null) || {
      echo "$(red '✗') case create fail"; exit 1; }
  fi
  [ -f "$TOKEN_FILE" ] || "$PY" -c 'import secrets; print("rp-"+secrets.token_hex(16))' > "$TOKEN_FILE"
  ( cd "$REPO" && setsid nohup env RP_BROWSER_TOKEN="$(cat "$TOKEN_FILE")" \
      "$RP" browser serve "$CASE" \
      > "$BRIDGE_LOG" 2>&1 < /dev/null & )
  for i in $(seq 1 10); do
    sleep 1
    bridge_up && break
  done
  if ! bridge_up; then
    echo "$(red '✗') bridge start nahi hua — log: $BRIDGE_LOG"
    exit 7
  fi
  echo "$(grn '✓') bridge live: 127.0.0.1:8765"
  fi
  echo "  token (copy → extension popup): $(bold "$(cat "$TOKEN_FILE" 2>/dev/null)")"
  echo
  echo "$(bold 'Firefox setup (qadam ba qadam):')"
  echo "  1. Firefox kholo → address bar mein: $(bold 'about:debugging#/runtime/this-firefox')"
  echo "  2. $(bold 'Load Temporary Add-on…') dabao"
  echo "  3. File chuno: $(bold "$REPO/extension/manifest.json")"
  echo "  4. Toolbar mein Rebel icon → token paste → $(bold 'Save') → $(bold 'Check bridge')"
  echo "  5. $(bold 'Grant site access') dabao (ek dafa) → $(bold 'Run now')"
  echo "  Phir job do:  $(bold "rp grab https://in-scope-url/")  — ya hermes se bolo."
  echo "  Monitor:      $(bold 'tail -f $BRIDGE_LOG')"
}

do_grab() {
  # rp grab <url> [extractors] — submit a browser-extract job + tell the
  # operator exactly what will happen (the extension does the rest).
  local url="${1:-}"; [ -n "$url" ] || { echo "usage: rp grab <url> [extractors]"; exit 2; }
  shift
  local extract="${1:-title,links,text}"
  local CASE; CASE=$(newest_case || true)
  [ -n "$CASE" ] || { echo "$(red '✗') koi case nahi — pehle case banao"; exit 1; }
  do_bridge >/dev/null 2>&1 || true
  bridge_up || { echo "$(red '✗') bridge live nahi — 'rp bridge' chalao"; exit 7; }
  local out job
  out=$("$RP" browser submit "$CASE" "$url" --extract "$extract" -o json 2>&1) || {
    echo "$out"; exit 1; }
  job=$(printf '%s' "$out" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["data"]["job_id"])' 2>/dev/null)
  echo "$(grn '✓') job $(bold "$job") queued → $url"
  echo "  extension (Firefox mein loaded) ~10s mein uthayega, tab khol kar padhega,"
  echo "  result wapas bridge ko dega — evidence + claims khud ban jayenge."
  echo "  Result: $(bold "rp job $job")   Monitor: $(bold "tail -f $BRIDGE_LOG")"
}

do_job() {
  local job="${1:-}"
  [ -n "$job" ] || { echo "usage: rp job <job-id>"; exit 2; }
  exec "$RP" browser result "$job"
}

# ----------------------------------------------------------------- main ---

cmd="${1:-status}"
case "$cmd" in
  status|-h|--help|help) do_status ;;
  --version|-V|-v) exec "$RP" --version ;;   # real CLI owns version output
  talk)   shift; [ $# -gt 0 ] && hermes_cmd "$@" || hermes_cmd ;;
  bridge) shift; do_bridge "$@" ;;
  grab)   shift; do_grab "$@" ;;
  job)    shift; do_job "$@" ;;
  *)      hermes_cmd "$@" ;;   # anything else = a prompt to Hermes
esac

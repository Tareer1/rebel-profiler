__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.rp/
*.sqlite3
*.sqlite3-journal
.venv/
venv/
.env

# design-source PDFs stay out of the repo (content is mirrored in docs/)
pdf *

# Model weights stay out of the repo: they are multi-GB and GitHub rejects
# files over 100MB. Keep checkpoints in the HF cache or a path outside git and
# point the tool at them (--model <path> / RP_LLM__MODEL / RP_LLM__GGUF_DIRS).
dphn/
models/
*.gguf
*.gguf.part
*.safetensors
*.safetensors.part

# Local guide/PDF drafts — workbench material, not part of the repo.
docs/guide/drafts/

# Generated artifacts (the frontend handoff brief is an exception: it is
# meant to travel as a single file, so the generated PDF is versioned too)
*.pdf
!docs/FRONTEND_BRIEF.pdf

# Job profiles may hold machine-specific model paths (hermes.example.toml is
# the committed template; copy it to hermes.toml and edit for your machine).
hermes.toml
